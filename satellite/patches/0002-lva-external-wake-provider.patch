@@ -0,0 +1,20 @@
+"""Optional external wake-word feed for SaySo and other overlays."""
+
+from __future__ import annotations
+
+from typing import Callable, Optional, TYPE_CHECKING
+
+if TYPE_CHECKING:
+    from .models import ServerState
+
+ExternalWakeCallback = Callable[["ServerState", bytes], None]
+_provider: Optional[ExternalWakeCallback] = None
+
+
+def set_provider(callback: Optional[ExternalWakeCallback]) -> None:
+    global _provider
+    _provider = callback
+
+
+def feed(state: "ServerState", audio_chunk: bytes) -> None:
+    if _provider is not None:
+        _provider(state, audio_chunk)
