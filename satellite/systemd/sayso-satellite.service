[Unit]
Description=SaySo Linux Voice Assistant satellite
StartLimitBurst=5
StartLimitIntervalSec=120
After=pipewire.service pipewire-pulse.service wireplumber.service network-online.target
Wants=pipewire.service pipewire-pulse.service wireplumber.service

[Service]
Type=simple
Environment=PYTHONPATH=/opt/sayso-satellite
Environment=PREFERENCES_FILE=%h/.local/state/sayso-satellite/preferences.json
ExecStartPre=/opt/sayso-satellite/.venv/bin/python -m sayso.cli wait-audio
ExecStart=/opt/sayso-satellite/.venv/bin/python -m sayso.launcher
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sayso-satellite

[Install]
WantedBy=default.target
