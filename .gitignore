# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Secrets / local state
context.json
.env
*.env

# Training artifacts (never commit)
training/artifacts/*
!training/artifacts/.gitkeep
training/datasets/*.jsonl
!training/datasets/README.md
!training/datasets/.gitkeep
training/datasets/*/
training/checkpoints/
training/runs/
training/*.gguf
training/**/*.gguf

# Hugging Face / model caches
.cache/
.huggingface/
training/.cache/
training/hf_cache/

# Large generated outputs
*.safetensors
*.bin
*.pt
*.ckpt

# Recorded wake-word audio. Real household speech in a public repo: the corpus
# definition (satellite/eval/cases.json) is tracked, the recordings are not.
# Build a corpus outside the repo with scripts/wake_prepare_real_data.py and pass
# it to satellite/eval/run.py --eval-root.
satellite/eval/audio/*
!satellite/eval/audio/.gitkeep

# livekit-wakeword run artifacts (relative to the CWD the CLI runs in)
/data/
/output/
