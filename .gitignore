# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Secrets / local state
context.json
.env
*.env

# Training artifacts (never commit)
training/artifacts/*
!training/artifacts/.gitkeep
training/datasets/*.jsonl
!training/datasets/README.md
!training/datasets/.gitkeep
training/datasets/*/
training/checkpoints/
training/runs/
training/*.gguf
training/**/*.gguf

# Weights never belong in the repo: every quant of a 230M model is over
# GitHub's 100 MB file limit, and HACS would re-download the whole integration
# directory on every update. Ship them as GitHub Release assets instead and
# point DEFAULT_MODEL_URL at one. See docs/PLAN_EMBEDDED_INFERENCE.md.
*.gguf

# Hugging Face / model caches
.cache/
.huggingface/
training/.cache/
training/hf_cache/

# Large generated outputs
*.safetensors
*.bin
*.pt
*.ckpt

# Eval run outputs (metadata is regenerated per run)
evals/results/*
!evals/results/.gitkeep

# Wake-word training artifacts (satellite/models/)
satellite/models/data/
satellite/models/output/
satellite/models/NwwResourcesModel/
satellite/models/dataset/
satellite/models/tts_models/
satellite/models/**/*.wav
satellite/models/**/*.npy
